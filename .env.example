# Copy to .env and fill in. .env is git-ignored; never commit it.

# Which voice layer runs a call: cascade (Deepgram -> Claude Haiku -> Kokoro),
# gemini (speech-to-speech, Gemini Live), openai (speech-to-speech, OpenAI GPT-Live-1,
# not built yet) or none (silent stub for tests).
VOICE=cascade

# Option B: cascade
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
# DEEPGRAM_MODEL=nova-3
# ANTHROPIC_MODEL=claude-haiku-5-5
# KOKORO_VOICE=ef_dora

# Option A1: Gemini Live (Gemini API key from Google AI Studio). On the free tier,
# Google may use the audio to improve its products: test with scripted callers only.
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_VOICE=Kore

# Option A2: OpenAI GPT-Live-1 (not built yet; leave empty)
OPENAI_API_KEY=

# Call server
HOST=0.0.0.0
PORT=7860
