# Copy to .env and fill in. .env is git-ignored; never commit it.

# Which voice layer runs a call: cascade (Deepgram -> Claude Haiku -> Kokoro),
# s2s (speech-to-speech, not built yet) or none (silent stub for tests).
VOICE=cascade

# Option B: cascade
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
# DEEPGRAM_MODEL=nova-3
# ANTHROPIC_MODEL=claude-haiku-5-5
# KOKORO_VOICE=ef_dora

# Option A: speech-to-speech (not used yet; leave empty)
OPENAI_API_KEY=

# Call server
HOST=0.0.0.0
PORT=7860
